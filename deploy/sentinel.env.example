# Copy to deploy/sentinel.env on the server and fill in. Never commit the copy.
#
#   cp deploy/sentinel.env.example deploy/sentinel.env
#   nano deploy/sentinel.env
#   chmod 600 deploy/sentinel.env

# Domain pointing at this server, or its public IPv4 address.
SENTINEL_SITE=203.0.113.10

# auto = Let's Encrypt (domain only); internal = self-signed (works with an IP).
SENTINEL_TLS=internal

SENTINEL_ADMIN_USER=admin
# At least 12 characters. Generate one: openssl rand -base64 18
SENTINEL_ADMIN_PASSWORD=
# Signs session cookies. Generate: openssl rand -base64 48
SENTINEL_SESSION_SECRET=

# Optional: Gemini post-incident reports. Leave the key empty to use the
# deterministic report. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
